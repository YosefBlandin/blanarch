# Server settings. Copy to server/.env (git-ignored) for `npm -w server run dev`, `migrate` and `db:types`.
# DATABASE_URL matches the placeholders in the root .env.example, so copying both files gives a working setup.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://blanarch:local-dev-only@127.0.0.1:5432/blanarch
LOG_LEVEL=info
